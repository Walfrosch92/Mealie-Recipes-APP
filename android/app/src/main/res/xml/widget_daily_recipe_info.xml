<?xml version="1.0" encoding="utf-8"?>
<!-- Rezept-des-Tages-AppWidget — fängt klein an (~2x2), kann zu 4x4 wachsen. -->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialKeyguardLayout="@layout/widget_loading"
    android:initialLayout="@layout/widget_loading"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="110dp"
    android:minResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:description="@string/widget_daily_recipe_description"
    android:previewImage="@drawable/ic_widget_sparkles"
    android:previewLayout="@layout/widget_daily_recipe_preview"
    android:resizeMode="horizontal|vertical"
    android:updatePeriodMillis="0"
    android:widgetCategory="home_screen" />
