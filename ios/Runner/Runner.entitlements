<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>aps-environment</key>
	<string>development</string>
	<!-- Time-Sensitive Notifications: lässt den Timer-Alarm Fokus-/„Nicht
	     stören"-Modi durchbrechen und prompt MIT Ton zustellen. Standard-
	     Capability, KEINE Apple-Sonderfreigabe nötig (anders als Critical
	     Alerts). Macht das `interruptionLevel:.timeSensitive` der Notification
	     wirksam. -->
	<key>com.apple.developer.usernotifications.time-sensitive</key>
	<true/>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.Walfrosch92.MealieRecipes</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>com.apple.developer.ubiquity-kvstore-identifier</key>
	<string>$(TeamIdentifierPrefix)$(CFBundleIdentifier)</string>
	<!-- WLAN-Umschaltung der Server-Adresse: Name des verbundenen WLANs
	     lesen (CNCopyCurrentNetworkInfo / NEHotspotNetwork). Zusätzlich
	     ist die Standortberechtigung „Bei Nutzung" nötig. -->
	<key>com.apple.developer.networking.wifi-info</key>
	<true/>
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.Walfrosch92.MealieRecipes</string>
	</array>
</dict>
</plist>
